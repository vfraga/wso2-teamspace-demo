# ─── WSO2 Identity Server ───
IS_BASE_URL=https://localhost:9443
# Tenant handle for WSO2 IS. Set to "teamspace" for tenant mode, leave empty for carbon.super
IS_ORG_HANDLE=teamspace
# Path to a clean/fresh installation of WSO2 IS 7.2.0.24 (required ONLY for running live E2E tests)
WSO2_IS_TEMPLATE_PATH=/path/to/wso2is-7.2.0.24

# ─── TLS Verification ───
# Set to false for local dev with self-signed WSO2 certs
IS_VERIFY_TLS=false

# ─── OAuth2 Application ───
# CLIENT_ID / CLIENT_SECRET / APP_ID are generated by `python setup_is.py`.
# Run that script, then paste the printed values here.
CLIENT_ID=<from setup_is.py output>
CLIENT_SECRET=<from setup_is.py output>
APP_ID=<application ID from setup_is.py output>
APP_NAME=Teamspace

# ─── Flask App ───
FLASK_SECRET_KEY=<random-32-byte-hex>
FLASK_HOST=localhost
FLASK_PORT=5001
# Standard Flask flag. `flask run` (used by start.sh) auto-loads this file and
# honours FLASK_DEBUG, enabling debug mode + the reloader when set to true.
FLASK_DEBUG=true
# Set to "production" to enable secure session cookies, a strict CSP header,
# and an INFO default log level.
# FLASK_ENV=production

# ─── Observability (all three services) ───
# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Left unset, Teamspace defaults to DEBUG so you can watch the identity flow
# (token exchange, OBO state, masked token claims) — that is the point of the
# demo. FLASK_ENV=production lowers the default to INFO. An explicit value
# here always wins.
# LOG_LEVEL=DEBUG

# ─── Serving ───
# `production` makes start.sh serve all three services behind gunicorn instead
# of the Flask/uvicorn dev servers. Anything else keeps the dev servers, so the
# quickstart is unchanged.
# SERVE_MODE=production
# API_WORKERS=4
# AGENT_WORKERS=4
# WEBAPP_WORKERS=4
# Whether the Business API creates missing tables at startup. Defaults on
# outside production (so the demo boots on an empty DB) and off when
# FLASK_ENV=production, where `alembic upgrade head` owns the schema.
# DB_AUTO_CREATE=true

# ─── Shared State (Redis) ───
# One setting makes the whole stack multi-instance capable: the agent's OBO
# state (PKCE verifier, tokens, chat history), Flask sessions, and the
# rate-limit counters all move to Redis. Leave unset for the single-instance
# demo — everything falls back to in-process/filesystem storage.
#
# NOTE: OBO access tokens and per-org agent credentials are at rest in Redis.
# Require AUTH and TLS for anything beyond a local demo.
# Install the extra first: uv sync --extra redis
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=

# ─── Rate Limiting ───
# Defaults are set well above any demo walkthrough. Counters are per-process
# unless REDIS_URL is set.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT=60/minute
# RATE_LIMIT_AUTH=120/minute
# RATE_LIMIT_DEFAULT=600/minute
# Only enable behind a proxy you control — otherwise a client can forge the
# header and get its own bucket.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false
# Ceiling on simultaneously-open MCP SSE streams on the agent. Each connection
# is held open for its lifetime, so this bounds worker exhaustion.
# MAX_MCP_SSE_STREAMS=32

# ─── Business API ───
BUSINESS_API_URL=http://localhost:9091
# SQLAlchemy connection string (defaults to a local SQLite file if unset)
# DATABASE_URL=sqlite:///teamspace.db
# Comma-separated CORS allow-list for the FastAPI services
# ALLOWED_ORIGINS=http://localhost:5001

# ─── AI Agent (Phase 2) ───
AGENT_SERVICE_URL=http://localhost:8000
AGENT_REDIRECT_URI=http://localhost:8000/callback
GEMINI_API_KEY=<from Google AI Studio>
# Set to true to run the agent without calling Gemini (used by the test suite)
# MOCK_LLM=false

# ─── Service-to-Service (M2M) Auth ───
#   Nothing to configure. The three services authenticate to each other with
#   OAuth 2.0 client-credentials tokens minted from the CLIENT_ID/CLIENT_SECRET
#   above and sent in the `X-Service-Authorization` header:
#
#     webapp -> agent            (/chat, /chat/stream, /state, /agent-token, /clear)
#     webapp -> Business API     (agent-config lookup for the chat panel)
#     agent  -> Business API     (the agent reading its own org's config)
#
#   The receiving service verifies the token against WSO2 IS's JWKS — RS256,
#   audience, issuer and expiry — and then requires the `internal_service`
#   scope. `setup_is.py` provisions that scope on a "Teamspace Internal
#   Services" API resource authorized with NO_POLICY, which is required for
#   application-only tokens to carry any scope at all.
#
#   This replaced a static `X-Internal-Secret` shared secret (three env vars:
#   AGENT_INTERNAL_SECRET, INTERNAL_SECRET, BUSINESS_API_INTERNAL_SECRET).
#   Remove them from any existing .env — they are no longer read.

# ─── Agent OAuth State Signing ───
#   HMAC key for the `state` JWT in the agent's OBO flow. /authorize signs it
#   and /callback verifies it, so it must be STABLE and SHARED across every
#   agent instance — with more than one worker those are different processes.
#   Falls back to CLIENT_SECRET if unset, so the demo needs no value here.
#   Never auto-generated: a random key would only verify on the instance that
#   signed it. Required when FLASK_ENV=production and CLIENT_SECRET is unset.
# AGENT_STATE_SIGNING_SECRET=<random 32-byte hex>

# ─── Default Branding (jsDelivr CDN) ───
# Base URL for the project's demo image assets on the CDN. The setup scripts
# derive their logo/favicon URLs from it (Teamspace and the Worklink IdP).
# CDN_IMG_BASE_URL=https://cdn.jsdelivr.net/gh/vfraga/wso2-teamspace-demo@main/webapp/static/img
# Optional — fall back logo/favicon used when an org has no custom branding.
# DEFAULT_LOGO_URL=https://cdn.jsdelivr.net/gh/vfraga/wso2-teamspace-demo@main/webapp/static/img/teamspace-logo.svg
# DEFAULT_FAVICON_URL=https://cdn.jsdelivr.net/gh/vfraga/wso2-teamspace-demo@main/webapp/static/img/teamspace-favicon.svg

# ─── Federated Identity Provider (optional — external-IdP / SSO demo) ───
FEDERATED_IDP_URL=https://localhost:9444/t/worklink.com/scim2/Users
FEDERATED_IDP_ADMIN_USER=teamspaceadmin@worklink.com
FEDERATED_IDP_ADMIN_PASSWORD=
# Branding for the Worklink IdP login page on :9444 (setup_idp_server.py).
# Logo/favicon default to CDN_IMG_BASE_URL + the worklink-idp-* assets.
# WORKLINK_IDP_LOGO_URL=
# WORKLINK_IDP_FAVICON_URL=
# WORKLINK_IDP_PRIMARY_COLOR="#155E75"
# WORKLINK_IDP_SECONDARY_COLOR="#D7EEF5"

# ─── Setup-Script Credentials ───
# Consumed by setup_is.py / setup_idp_server.py / setup_secondary_is.py.
# IS_SUPER_ADMIN_PASSWORD and IS_TENANT_ADMIN_PASSWORD are REQUIRED to bootstrap;
# without them the IS API calls return 401.
IS_SUPER_ADMIN_USERNAME=admin
IS_SUPER_ADMIN_PASSWORD=<WSO2 IS super-admin password>
# Becomes the teamspaceadmin tenant admin password — this is your portal login.
IS_TENANT_ADMIN_PASSWORD=<choose-a-password>
# Password for the federated IdP's seeded test users (setup_idp_server.py).
FEDERATED_USER_PASSWORD=<choose-a-password>
